# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NOMINATIM_USER_AGENT: Custom user agent string for OpenStreetMap Nominatim geocoding requests
NOMINATIM_USER_AGENT="SafeCycle-Bike-Planner/2.1 (contact: safety@safecycle.org)"

# OPENROUTESERVICE_API_KEY (Optional): Optional API key for OpenRouteService cycling profiles
# If omitted, SafeCycle uses its built-in local graph Dijkstra engine and OSM benchmark data
OPENROUTESERVICE_API_KEY=""

# GRAPHHOPPER_API_KEY (Optional): Optional GraphHopper bike routing API key
GRAPHHOPPER_API_KEY=""
